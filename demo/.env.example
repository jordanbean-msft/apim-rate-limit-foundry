# Only for an isolated local Table/Redis pair. Never commit demo/.env.
AZURE_CLOUD=commercial
LOCAL_STORE_ENABLED=true
LOCAL_REDIS_URL=redis://127.0.0.1:6379/0
LOCAL_TABLE_CONNECTION_STRING=UseDevelopmentStorage=true
TABLE_NAME=OfficeDemo
# No inference is performed. Match the application's deployment-managed model registry.
MODEL_REGISTRY={"openai-chat:gpt-5.4":{"api_protocol":"openai-chat","endpoint":"https://example.openai.azure.com","path":"/openai/deployments/gpt-5.4/chat/completions","model":"gpt-5.4","audience":"https://cognitiveservices.azure.com","api_version":"2024-10-21","price_version":"azure-global-text-2026-11-06","max_input_tokens":128000,"max_output_tokens":4096},"openai-responses:gpt-5.4-mini":{"api_protocol":"openai-responses","endpoint":"https://example.openai.azure.com","path":"/openai/v1/responses","model":"gpt-5.4-mini","audience":"https://cognitiveservices.azure.com","api_version":"","price_version":"azure-global-text-2026-11-06","max_input_tokens":64000,"max_output_tokens":4096}}
