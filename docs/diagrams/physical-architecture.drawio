        <mxCell id="subtitle" value="Supported configuration pattern, NOT a deployed or Government-validated topology. App Service hosts are PaaS outside the VNet." style="text;html=0;fontFamily=Helvetica;fontSize=17;align=left;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1600" height="40" as="geometry" /></mxCell>
