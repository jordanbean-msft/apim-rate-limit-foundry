<mxfile host="Electron" type="device">
  <diagram id="logical" name="Logical architecture">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Granular AI rate limiting | Logical architecture" style="text;html=0;fontFamily=Helvetica;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;fontColor=#17324d;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="APIM enforces the decision; Python owns policy, pricing and accounting. Cloud-neutral responsibilities, not a deployment diagram." style="text;html=0;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=middle;fontColor=#52657a;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1510" height="40" as="geometry" />
        </mxCell>
        <mxCell id="client" value="Calling applications&#xa;&#xa;Entra access token AND&#xa;product subscription key" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#f3f6fb;strokeColor=#7c93ad;fontColor=#17324d;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="apim" value="API Management&#xa;&#xa;Validate identity / bounds&#xa;Native burst protection&#xa;Select service / model&#xa;Reserve before dispatch" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f2ff;strokeColor=#0067b8;strokeWidth=2;fontColor=#17324d;fontFamily=Helvetica;fontSize=19;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="360" y="170" width="280" height="230" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="Python accounting Engine&#xa;Used by BOTH Function hosts&#xa;&#xa;All matching rules + pinned prices&#xa;Atomic reserve / settle / recovery&#xa;Control host: admin / reports" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f2ff;strokeColor=#0067b8;strokeWidth=2;fontColor=#17324d;fontFamily=Helvetica;fontSize=18;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="350" height="230" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="Enabled model backends&#xa;&#xa;Chat Completions | Responses&#xa;Messages only when approved" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e9f6f3;strokeColor=#087f8c;fontColor=#17324d;fontFamily=Helvetica;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="170" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="services" value="Document Intelligence&#xa;+ AI Language&#xa;&#xa;Owned analysis polling&#xa;Sentiment / text records" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e9f6f3;strokeColor=#087f8c;fontColor=#17324d;fontFamily=Helvetica;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="360" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="denial" value="Custom 429 + retry / reset&#xa;No dispatch or new debit" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#fff0f2;strokeColor=#bd2544;fontColor=#8a1830;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="480" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stream" value="Separate streaming Function&#xa;&#xa;Fixed backend + bound body&#xa;Preserve incremental provider SSE&#xa;Save trusted terminal usage" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#e8f2ff;strokeColor=#0067b8;strokeWidth=2;fontColor=#17324d;fontFamily=Helvetica;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="560" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="state" value="Shared state&#xa;No distributed ACID transaction" style="swimlane;startSize=42;horizontal=1;container=1;pointerEvents=0;rounded=1;fillColor=#f1f7f5;swimlaneFillColor=#ffffff;strokeColor=#8ab5a5;fontColor=#17324d;fontFamily=Helvetica;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="560" width="370" height="360" as="geometry" />
        </mxCell>
