          <mxGeometry x="40" y="530" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="portal" value="React + Node 24 portal&#xa;&#xa;Application budgets and usage&#xa;Same-origin server API proxy&#xa;No keys in the browser" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#f2edfc;strokeColor=#8064a2;fontColor=#17324d;fontFamily=Helvetica;fontSize=17;spacing=12;" vertex="1" parent="1">
