# Local-only development. Copy to .env; never deploy these bypass flags.
AZURE_CLOUD=commercial
LOCAL_AUTH_ENABLED=true
LOCAL_STORE_ENABLED=true
SEED_LOCAL_AUTH=true
SEED_API_URL=http://127.0.0.1:8000/api
# PORT=8000

# Optional persistent local mode: start compose services and create the table first.
# Both settings are required together; omit both to keep in-memory stores.
# LOCAL_REDIS_URL=redis://127.0.0.1:6379/0
# LOCAL_TABLE_CONNECTION_STRING=UseDevelopmentStorage=true

# Local request headers (explicitly opt in via LOCAL_AUTH_ENABLED):
# X-Local-Tenant-Id: local-tenant
# X-Local-Principal-Id: local-admin
# X-Local-Roles: RateLimit.Admin
# Workload calls instead require X-Local-Roles: RateLimit.Gateway.

# Production app settings are generated by Terraform:
# AZURE_CLOUD=commercial|government
# AZURE_TENANT_ID=<tenant>
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# TABLE_ENDPOINT=https://<account>.table.core.windows.net
# TABLE_NAME=RateLimiter
# REDIS_HOST=<cloud-specific-host>
# REDIS_PORT=6380
# REDIS_USERNAME=<managed-identity-object-id>
# REDIS_TOKEN_SCOPE=<verified-cloud-specific-redis-scope>
# LOCAL_AUTH_ENABLED=false
# LOCAL_STORE_ENABLED=false
# WEBSITE_AUTH_ENABLED=true
