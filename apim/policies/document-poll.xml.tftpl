<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="limiter-identity" />
    <set-variable name="operation-id" value='@(context.Request.MatchedParameters["operationId"])' />
    <choose>
      <when condition='@(!System.Text.RegularExpressions.Regex.IsMatch((string)context.Variables["operation-id"], "^[a-fA-F0-9-]{36}$"))'>
        <return-response><set-status code="400" reason="Invalid operation ID" /></return-response>
      </when>
    </choose>
    <send-request mode="new" response-variable-name="operation-owner" timeout="${send_request_timeout}" ignore-error="true">
      <set-url>${function_url}/api/operations/check</set-url>
      <set-method>POST</set-method>
      <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-body>@(new JObject(new JProperty("operation_id", (string)context.Variables["operation-id"]),
        new JProperty("principal_id", (string)context.Variables["principal-id"]),
        new JProperty("tenant_id", (string)context.Variables["tenant-id"]),
        new JProperty("model", "${model}")).ToString())</set-body>
      <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
    </send-request>
    <choose>
      <when condition='@(!context.Variables.ContainsKey("operation-owner") || context.Variables["operation-owner"] == null || ((IResponse)context.Variables["operation-owner"]).StatusCode != 200)'>
        <return-response><set-status code="503" reason="Operation check unavailable" /></return-response>
      </when>
    </choose>
    <set-variable name="operation-metadata" value='@(((IResponse)context.Variables["operation-owner"]).Body.As&lt;string&gt;())' />
    <choose>
      <when condition='@(!(bool)JObject.Parse((string)context.Variables["operation-metadata"])["allowed"])'>
        <return-response><set-status code="404" reason="Operation not found" /></return-response>
      </when>
    </choose>
    <set-variable name="reservation-id" value='@((string)JObject.Parse((string)context.Variables["operation-metadata"])["reservation_id"])' />
    <set-backend-service base-url="${endpoint}" />
    <rewrite-uri template='@("/documentintelligence/documentModels/${model}/analyzeResults/" + (string)context.Variables["operation-id"])' copy-unmatched-params="false" />
    <set-query-parameter name="api-version" exists-action="override"><value>${api_version}</value></set-query-parameter>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <authentication-managed-identity resource="${ai_audience}" client-id="${gateway_client_id}" />
  </inbound>
  <backend><forward-request buffer-response="false" /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="X-RateLimit-Reservation" exists-action="override"><value>@((string)context.Variables["reservation-id"])</value></set-header>
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
    <choose>
      <when condition="@(context.Response.StatusCode == 200)">
        <set-variable name="actual-usage" value='@{
          var body = context.Response.Body.As&lt;JObject&gt;(preserveContent: true);
          if ((string)body["status"] != "succeeded") { return ""; }
          var result = body["analyzeResult"] as JObject;
          if (result == null || !(result["pages"] is JArray)) { return ""; }
          return new JObject(new JProperty("pages", ((JArray)result["pages"]).Count), new JProperty("requests", 1)).ToString();
        }' />
        <choose>
          <when condition='@(!String.IsNullOrEmpty((string)context.Variables["actual-usage"]))'>
            <include-fragment fragment-id="limiter-settle" />
          </when>
        </choose>
      </when>
    </choose>
  </outbound>
  <on-error><base /></on-error>
</policies>
