<choose>
  <when condition="@(context.Response.StatusCode == 202)">
    <set-variable name="operation-id" value='@{
      var location = context.Response.Headers.GetValueOrDefault("Operation-Location", "");
      var match = System.Text.RegularExpressions.Regex.Match(location, "/analyzeResults/([a-fA-F0-9-]{36})(\\?|$)");
      return match.Success ? match.Groups[1].Value : "";
    }' />
    <choose>
      <when condition='@(String.IsNullOrEmpty((string)context.Variables["operation-id"]))'>
        <return-response><set-status code="502" reason="Invalid operation metadata" /></return-response>
      </when>
    </choose>
    <send-request mode="new" response-variable-name="operation-binding" timeout="${send_request_timeout}" ignore-error="true">
      <set-url>${function_url}/api/operations/bind</set-url>
      <set-method>POST</set-method>
      <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-body>@(new JObject(new JProperty("operation_id", (string)context.Variables["operation-id"]),
        new JProperty("reservation_id", (string)context.Variables["reservation-id"]),
        new JProperty("principal_id", (string)context.Variables["principal-id"]),
        new JProperty("subscription_id", (string)context.Variables["subscription-id"]),
        new JProperty("tenant_id", (string)context.Variables["tenant-id"]),
        new JProperty("model", (string)context.Variables["model"])).ToString())</set-body>
      <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
    </send-request>
    <choose>
      <when condition='@(!context.Variables.ContainsKey("operation-binding") || context.Variables["operation-binding"] == null || ((IResponse)context.Variables["operation-binding"]).StatusCode != 200 || !(bool)((IResponse)context.Variables["operation-binding"]).Body.As&lt;JObject&gt;()["allowed"])'>
        <return-response><set-status code="503" reason="Operation binding unavailable" /></return-response>
      </when>
    </choose>
    <set-header name="Operation-Location" exists-action="override">
      <value>@(context.Request.OriginalUrl.Scheme + "://" + context.Request.OriginalUrl.Host + "/document-intelligence/analyzeResults/" + (string)context.Variables["operation-id"])</value>
    </set-header>
  </when>
</choose>
