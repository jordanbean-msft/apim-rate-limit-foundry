<choose>
  <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false) &amp;&amp; context.Response.StatusCode == 200)'>
    <set-variable name="actual-usage" value='@{
      var body = context.Response.Body.As&lt;JObject&gt;(preserveContent: true);
      var usage = body["usage"] as JObject;
      if (usage == null || usage["prompt_tokens"] == null || usage["completion_tokens"] == null) { return ""; }
      var details = usage["prompt_tokens_details"] as JObject;
      var actual = new JObject(new JProperty("input_tokens", (int)usage["prompt_tokens"]),
        new JProperty("output_tokens", (int)usage["completion_tokens"]),
        new JProperty("requests", 1));
      if (details != null &amp;&amp; details["cached_tokens"] != null) {
        actual["cached_input_tokens"] = (int)details["cached_tokens"];
      }
      return actual.ToString();
    }' />
    <choose>
      <when condition='@(!String.IsNullOrEmpty((string)context.Variables["actual-usage"]))'>
        <include-fragment fragment-id="limiter-settle" />
      </when>
    </choose>
  </when>
</choose>
