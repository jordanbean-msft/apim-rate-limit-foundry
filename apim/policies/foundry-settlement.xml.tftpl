<choose>
  <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false) &amp;&amp; context.Response.StatusCode == 200 &amp;&amp; context.Response.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json"))'>
    <set-variable name="provider-usage" value='@{
      try {
        var body = context.Response.Body.As&lt;JObject&gt;(preserveContent: true);
        if (body["service_tier"] != null &amp;&amp; (body["service_tier"].Type != JTokenType.String ||
            !new [] {"default","standard"}.Contains((string)body["service_tier"]))) { return ""; }
        if (body["inference_geo"] != null) { return ""; }
        var usage = body["usage"] as JObject;
        if (usage == null || System.Text.Encoding.UTF8.GetByteCount(usage.ToString()) &gt; 8192) { return ""; }
        var permitted = new [] {
          "prompt_tokens", "completion_tokens", "total_tokens", "prompt_tokens_details", "completion_tokens_details",
          "input_tokens", "output_tokens", "input_tokens_details", "output_tokens_details",
          "cache_read_input_tokens", "cache_creation_input_tokens", "cache_creation",
          "server_tool_use", "service_tier", "inference_geo"
        };
        var result = new JObject();
        foreach (var field in usage.Properties()) {
          if (!permitted.Contains(field.Name)) { return ""; }
          result[field.Name] = field.Value;
        }
        foreach (var field in result.Properties()) {
          if (field.Name == "service_tier" || field.Name == "inference_geo") {
            if (field.Value.Type != JTokenType.String ||
                !System.Text.RegularExpressions.Regex.IsMatch((string)field.Value, "^[A-Za-z0-9._-]{1,64}$")) { return ""; }
          } else if (field.Value.Type == JTokenType.Object) {
            foreach (var detail in ((JObject)field.Value).Properties()) {
              if (detail.Value.Type != JTokenType.Integer) { return ""; }
            }
          } else if (field.Value.Type != JTokenType.Integer) { return ""; }
        }
        return result.ToString();
      } catch { return ""; }
    }' />
    <choose>
      <when condition='@(!String.IsNullOrEmpty((string)context.Variables["provider-usage"]))'>
        <include-fragment fragment-id="limiter-settle" />
      </when>
    </choose>
  </when>
</choose>
