<!-- Responses contract: stateless foreground requests with bounded inline text and client
     function history. Only what changes cost or the input bound is checked here; the provider
     still validates its own schema. The input bound is the request's UTF-8 size, which is an upper
     bound on tokens without a tokenizer, not a cost reservation. -->
<set-variable name="admission-error" value='@{
  try {
    var body = (JObject)context.Variables["request-json"];
    var fields = new [] {"model","input","instructions","max_output_tokens","stream","store","background","truncation",
      "temperature","top_p","tools","tool_choice","parallel_tool_calls","reasoning"};
    foreach (var field in body.Properties()) {
      if (!fields.Contains(field.Name)) { return "unsupported Responses field: " + field.Name; }
    }
    var max = body["max_output_tokens"];
    if (max == null || max.Type != JTokenType.Integer || (long)max &lt; 1 || (long)max &gt; (int)context.Variables["model-max-output-tokens"]) { return "bounded max_output_tokens is required"; }
    if (body["stream"] != null &amp;&amp; body["stream"].Type != JTokenType.Boolean) { return "stream must be boolean"; }
    if ((bool?)body["store"] == true || (bool?)body["background"] == true) { return "only stateless foreground Responses are supported"; }
    if (body["truncation"] != null &amp;&amp; (string)body["truncation"] != "disabled") { return "automatic history truncation is unsupported"; }
    var input = body["input"];
    if (input == null) { return "inline input is required"; }
    if (input.Type != JTokenType.String) {
      var items = input as JArray;
      if (items == null || items.Count == 0 || items.Count &gt; 128) { return "input must be text or 1-128 inline items"; }
      foreach (var item in items) {
        var type = item["type"] == null ? "message" : (string)item["type"];
        if (!new [] {"message","function_call","function_call_output"}.Contains(type)) { return "opaque history and provider-managed items are unsupported"; }
        var content = item["content"];
        if (type != "message" || content == null || content.Type == JTokenType.String) { continue; }
        var blocks = content as JArray;
        if (blocks == null || blocks.Count == 0 || blocks.Count &gt; 128 ||
            blocks.Any(block =&gt; !new [] {"input_text","output_text"}.Contains((string)block["type"]) || block["text"] == null || block["text"].Type != JTokenType.String)) { return "media, annotations and opaque history are unsupported"; }
      }
    }
    var tools = body["tools"] as JArray;
    if (body["tools"] != null &amp;&amp; (tools == null || tools.Count &gt; 128 || tools.Any(tool =&gt; (string)tool["type"] != "function"))) { return "only inline client function definitions are supported"; }
    if (System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; (int)context.Variables["model-max-input-tokens"]) { return "input exceeds the selected model bound"; }
    return "";
  } catch { return "malformed Responses request fields"; }
}' />
<choose>
  <when condition='@(!String.IsNullOrEmpty((string)context.Variables["admission-error"]))'>
    <return-response><set-status code="400" reason="Unsupported request" /><set-body>@((string)context.Variables["admission-error"])</set-body></return-response>
  </when>
</choose>
