<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="limiter-identity" />
    <set-variable name="api-protocol" value="${api_protocol}" />
    <set-variable name="legacy-default-alias" value="${legacy_default_alias}" />
    <choose>
      <when condition='@(!context.Request.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json"))'>
        <return-response><set-status code="415" reason="JSON only" /></return-response>
      </when>
    </choose>
    <set-variable name="request-body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <choose>
      <when condition='@(System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; ${max_body_bytes})'>
        <return-response><set-status code="413" reason="Request too large" /></return-response>
      </when>
    </choose>
    <set-variable name="valid-json" value='@{
      try { JObject.Parse((string)context.Variables["request-body"]); return true; }
      catch { return false; }
    }' />
    <choose>
      <when condition='@(!(bool)context.Variables["valid-json"])'>
        <return-response><set-status code="400" reason="JSON object required" /></return-response>
      </when>
    </choose>
    <include-fragment fragment-id="limiter-model-lookup" />
    ${admission}
    <choose>
      <when condition='@((bool)context.Variables["streaming"] &amp;&amp; !${streaming_enabled})'>
        <return-response><set-status code="400" reason="Streaming is unavailable" /></return-response>
      </when>
    </choose>
    <set-body>@{
      var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
      body["model"] = (string)context.Variables["model-provider"];
      if ((string)context.Variables["api-protocol"] == "openai-chat" &amp;&amp; (bool)context.Variables["streaming"]) {
        body["stream_options"] = new JObject(new JProperty("include_usage", true));
      }
      return body.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
    ${llm_policy}
    <include-fragment fragment-id="limiter-budget-check" />
    <set-variable name="budget-checked" value="@(true)" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="X-Usage-Request-ID" exists-action="delete" />
    <set-header name="X-MS-CLIENT-PRINCIPAL" exists-action="delete" />
    <set-header name="X-MS-CLIENT-PRINCIPAL-ID" exists-action="delete" />
    <set-header name="X-MS-CLIENT-PRINCIPAL-NAME" exists-action="delete" />
    <set-header name="X-MS-CLIENT-PRINCIPAL-IDP" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="x-api-key" exists-action="delete" />
    <set-header name="api-version" exists-action="delete" />
    <set-header name="OpenAI-Beta" exists-action="delete" />
    <set-header name="OpenAI-Organization" exists-action="delete" />
    <set-header name="OpenAI-Project" exists-action="delete" />
    <choose>
      <when condition='@((bool)context.Variables["streaming"])'>
        <set-backend-service base-url="${stream_url}" />
        <rewrite-uri template="/api/stream" copy-unmatched-params="false" />
        <set-header name="X-Usage-Request-ID" exists-action="override"><value>@((string)context.Variables["request-id"])</value></set-header>
        <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
      </when>
      <otherwise>
        <set-backend-service backend-id='@((string)context.Variables["model-backend-id"])' />
        <rewrite-uri template='@((string)context.Variables["model-path"])' copy-unmatched-params="false" />
        <choose>
          <when condition='@(!String.IsNullOrEmpty((string)context.Variables["model-api-version"]))'>
            <set-query-parameter name="api-version" exists-action="override"><value>@((string)context.Variables["model-api-version"])</value></set-query-parameter>
          </when>
        </choose>
        <authentication-managed-identity resource='@((string)context.Variables["model-audience"])' client-id="${gateway_client_id}" />
      </otherwise>
    </choose>
  </inbound>
  <backend><forward-request buffer-response="false" /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@((string)context.Variables["request-id"])</value></set-header>
    <choose>
      <when condition='@(!(bool)context.Variables["streaming"])'>
        <set-variable name="provider-body" value="@(context.Response.Body.As&lt;string&gt;(preserveContent: true))" />
        <set-variable name="provider-status" value="@(context.Response.StatusCode)" />
        <set-variable name="provider-content-type" value='@(context.Response.Headers.GetValueOrDefault("Content-Type", "application/json"))' />
        <include-fragment fragment-id="limiter-usage-record" />
      </when>
    </choose>
  </outbound>
  <on-error>
    <base />
    <trace source="usage-accounting" severity="error">
      <message>gateway_request_failed</message>
      <metadata name="request_id" value="@(context.RequestId.ToString())" />
      <metadata name="error_type" value="@(context.LastError.Source)" />
    </trace>
    <choose>
      <when condition='@(context.Variables.ContainsKey("provider-body"))'>
        <trace source="usage-accounting" severity="error"><message>usage_event_publish_failed</message><metadata name="error_type" value="@(context.LastError.Source)" /></trace>
        <return-response>
          <set-status code='@((int)context.Variables["provider-status"])' reason="Provider response" />
          <set-header name="Content-Type" exists-action="override"><value>@((string)context.Variables["provider-content-type"])</value></set-header>
          <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
          <set-body>@((string)context.Variables["provider-body"])</set-body>
        </return-response>
      </when>
      <when condition='@(context.Variables.GetValueOrDefault&lt;bool&gt;("budget-checked", false) &amp;&amp; !context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false))'>
        <set-variable name="provider-body" value="{}" />
        <include-fragment fragment-id="limiter-usage-record" />
      </when>
    </choose>
  </on-error>
</policies>
