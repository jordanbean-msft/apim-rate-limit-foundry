<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="limiter-identity" />
    <set-variable name="service" value="${service}" />
    <set-variable name="model" value="${model}" />
    <set-variable name="price-version" value="${price_version}" />
    <set-variable name="streaming" value="@(false)" />
    <choose>
      <when condition='@(!context.Request.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json"))'>
        <return-response><set-status code="415" reason="JSON only" /></return-response>
      </when>
    </choose>
    <set-variable name="request-body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <choose>
      <when condition='@(System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; ${max_body_bytes})'>
        <return-response><set-status code="413" reason="Bounded requests only" /></return-response>
      </when>
    </choose>
    <set-variable name="valid-json" value='@{
      try { JObject.Parse((string)context.Variables["request-body"]); return true; }
      catch { return false; }
    }' />
    <choose>
      <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("valid-json", false))'>
        <return-response><set-status code="400" reason="JSON object required" /></return-response>
      </when>
    </choose>
    ${admission}
    ${llm_policy}
    <include-fragment fragment-id="limiter-reserve" />
    <set-backend-service base-url="${endpoint}" />
    <rewrite-uri template="${backend_path}" copy-unmatched-params="false" />
    <set-query-parameter name="api-version" exists-action="override"><value>${api_version}</value></set-query-parameter>
    ${backend_query}
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <authentication-managed-identity resource="${ai_audience}" client-id="${gateway_client_id}" />
  </inbound>
  <backend><forward-request buffer-response="false" /></backend>
  <outbound>
    <base />
    <set-header name="X-RateLimit-Reservation" exists-action="override"><value>@((string)context.Variables["reservation-id"])</value></set-header>
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
    <set-header name="RateLimit-Remaining" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["remaining"].ToString())</value></set-header>
    <set-header name="RateLimit-Reset" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["reset_at"].ToString())</value></set-header>
    ${settlement}
  </outbound>
  <on-error>
    <base />
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
  </on-error>
</policies>
