<policies>
  <!-- Shared inference pipeline: authenticate, bound/validate JSON, resolve a trusted
       model, check Redis budgets, then dispatch ordinary or streaming requests. -->
  <inbound>
    <!-- Preserve the client's parent before backend forwarding mutates traceparent.
         APIM's generated W3C IDs are not exposed to policy expressions. -->
    <set-variable name="inference-traceparent" value='@{
      var parent = context.Request.Headers.GetValueOrDefault("traceparent", "");
      if (!System.Text.RegularExpressions.Regex.IsMatch(parent, "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$")) { return ""; }
      if (parent.Substring(3, 32) == new String(&apos;0&apos;, 32) || parent.Substring(36, 16) == new String(&apos;0&apos;, 16)) { return ""; }
      return parent;
    }' />
    <base />
    <include-fragment fragment-id="limiter-identity" />
    <set-variable name="api-protocol" value="${api_protocol}" />
    <set-variable name="legacy-default-alias" value="${legacy_default_alias}" />
    <choose>
      <when condition='@(!context.Request.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json"))'>
        <return-response><set-status code="415" reason="JSON only" /></return-response>
      </when>
    </choose>
    <set-variable name="request-body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <choose>
      <when condition='@(System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; ${max_body_bytes})'>
        <return-response><set-status code="413" reason="Request too large" /></return-response>
      </when>
    </choose>
    <!-- Parse once; every later step reads this object, which is JSON null when the body is invalid. -->
    <set-variable name="request-json" value='@{
      try { return JToken.Parse((string)context.Variables["request-body"]); }
      catch { return JValue.CreateNull(); }
    }' />
    <choose>
      <when condition='@(!(context.Variables["request-json"] is JObject))'>
        <return-response><set-status code="400" reason="JSON object required" /></return-response>
      </when>
    </choose>
    <include-fragment fragment-id="limiter-model-lookup" />
    ${admission}
    <set-variable name="streaming" value='@((bool?)((JObject)context.Variables["request-json"])["stream"] ?? false)' />
    <choose>
      <when condition='@((bool)context.Variables["streaming"] &amp;&amp; !${streaming_enabled})'>
        <return-response><set-status code="400" reason="Streaming is unavailable" /></return-response>
      </when>
    </choose>
    <!-- Replace the public alias with the registered provider deployment. Responses must stay
         stateless; Chat SSE must request terminal usage so the relay can price actual tokens. -->
    <set-body>@{
      var body = (JObject)context.Variables["request-json"];
      body["model"] = (string)context.Variables["model-provider"];
      if ((string)context.Variables["api-protocol"] == "openai-responses") {
        body["store"] = false;
        body["background"] = false;
      } else if ((bool)context.Variables["streaming"]) {
        body["stream_options"] = new JObject(new JProperty("include_usage", true));
      }
      return body.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
    ${llm_policy}
    <include-fragment fragment-id="limiter-budget-check" />
    <set-variable name="budget-checked" value="@(true)" />
    <include-fragment fragment-id="limiter-strip-caller-headers" />
    <choose>
      <when condition='@((bool)context.Variables["streaming"])'>
        <set-backend-service base-url="${stream_url}" />
        <rewrite-uri template="/api/stream" copy-unmatched-params="false" />
        <set-header name="X-Usage-Request-ID" exists-action="override"><value>@((string)context.Variables["request-id"])</value></set-header>
        <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
      </when>
      <otherwise>
        <set-backend-service backend-id='@((string)context.Variables["model-backend-id"])' />
        <rewrite-uri template='@((string)context.Variables["model-path"])' copy-unmatched-params="false" />
        <choose>
          <when condition='@(!String.IsNullOrEmpty((string)context.Variables["model-api-version"]))'>
            <set-query-parameter name="api-version" exists-action="override"><value>@((string)context.Variables["model-api-version"])</value></set-query-parameter>
          </when>
        </choose>
        <authentication-managed-identity resource='@((string)context.Variables["model-audience"])' client-id="${gateway_client_id}" />
      </otherwise>
    </choose>
  </inbound>
  <!-- Never buffer provider SSE in APIM; the streaming Function observes its termination.
       Only buffered, nonstreaming requests to a pooled alias retry (once or twice) on 429/5xx so
       the pool selects another member; the circuit breaker removes tripped members. Admission,
       budget checks and usage recording run once, outside this retry. -->
  <backend>
    <choose>
      <when condition='@(!(bool)context.Variables["streaming"] &amp;&amp; (bool)context.Variables["model-pooled"])'>
        <retry condition='@(context.Response != null &amp;&amp; (context.Response.StatusCode == 429 || context.Response.StatusCode &gt;= 500))' count="2" interval="1" first-fast-retry="true">
          <forward-request buffer-request-body="true" />
        </retry>
      </when>
      <otherwise>
        <forward-request buffer-response="false" />
      </otherwise>
    </choose>
  </backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@((string)context.Variables["request-id"])</value></set-header>
    <set-header name="X-RateLimit-Persistence" exists-action="override"><value>best-effort</value></set-header>
    <choose>
      <!-- A provider 4xx/5xx (including throttling) generated no tokens, so it is not charged.
           Gateway-side failures after admission may have consumed tokens and stay in on-error. -->
      <when condition='@(!(bool)context.Variables["streaming"] &amp;&amp; context.Response.StatusCode &lt; 400)'>
        <set-variable name="provider-body" value="@(context.Response.Body.As&lt;string&gt;(preserveContent: true))" />
        <include-fragment fragment-id="limiter-usage-record" />
      </when>
    </choose>
  </outbound>
  <on-error>
    <base />
    <trace source="usage-accounting" severity="error">
      <message>gateway_request_failed</message>
      <metadata name="request_id" value="@(context.RequestId.ToString())" />
      <metadata name="error_type" value="@(context.LastError.Source)" />
    </trace>
    <choose>
      <!-- An admitted request that failed before a provider response may still have consumed
           tokens, so record it as unknown usage; the recorder charges its pinned upper bound. -->
      <when condition='@(context.Variables.GetValueOrDefault&lt;bool&gt;("budget-checked", false) &amp;&amp; !context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false) &amp;&amp; !context.Variables.ContainsKey("provider-body"))'>
        <set-variable name="provider-body" value="{}" />
        <include-fragment fragment-id="limiter-usage-record" />
      </when>
    </choose>
  </on-error>
</policies>
