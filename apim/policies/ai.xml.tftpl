<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="limiter-identity" />
    <set-variable name="service" value="${service}" />
    <set-variable name="api-protocol" value="${api_protocol}" />
    <set-variable name="model" value="${model}" />
    <set-variable name="price-version" value="${price_version}" />
    <set-variable name="legacy-default-alias" value="${legacy_default_alias}" />
    <set-variable name="streaming" value="@(false)" />
    <choose>
      <when condition='@(!context.Request.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json"))'>
        <return-response><set-status code="415" reason="JSON only" /></return-response>
      </when>
    </choose>
    <set-variable name="request-body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <choose>
      <when condition='@(System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; ${max_body_bytes})'>
        <return-response><set-status code="413" reason="Bounded requests only" /></return-response>
      </when>
    </choose>
    <set-variable name="valid-json" value='@{
      try { JObject.Parse((string)context.Variables["request-body"]); return true; }
      catch { return false; }
    }' />
    <choose>
      <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("valid-json", false))'>
        <return-response><set-status code="400" reason="JSON object required" /></return-response>
      </when>
    </choose>
    ${model_lookup}
    ${admission}
    <choose>
      <when condition='@(!String.IsNullOrEmpty((string)context.Variables["api-protocol"]))'>
        <set-variable name="pinned-model-valid" value='@{
          var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
          return body["model"] == null || (body["model"].Type == JTokenType.String &amp;&amp; (string)body["model"] == (string)context.Variables["model"]);
        }' />
        <choose>
          <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("pinned-model-valid", false))'>
            <return-response><set-status code="400" reason="Model must match the pinned deployment" /></return-response>
          </when>
        </choose>
        <choose>
          <when condition='@(context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false))'>
            <set-header name="Content-Type" exists-action="override"><value>application/json; charset=utf-8</value></set-header>
          </when>
        </choose>
        <set-body>@{
          var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
          body["model"] = (string)context.Variables["model-provider"];
          if ((string)context.Variables["api-protocol"] == "openai-chat" &amp;&amp; context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false)) {
            body["stream_options"] = new JObject(new JProperty("include_usage", true));
          }
          return body.ToString();
        }</set-body>
      </when>
    </choose>
    ${llm_policy}
    <choose>
      <when condition='@(context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false))'>
        <set-variable name="payload-sha256" value='@{
          var bytes = System.Text.Encoding.UTF8.GetBytes(context.Request.Body.As&lt;string&gt;(preserveContent: true));
          return BitConverter.ToString(System.Security.Cryptography.SHA256.Create().ComputeHash(bytes)).Replace("-", "").ToLowerInvariant();
        }' />
      </when>
    </choose>
    <include-fragment fragment-id="limiter-reserve" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="X-RateLimit-Reservation" exists-action="delete" />
    <set-header name="X-RateLimit-Payload-SHA256" exists-action="delete" />
    <set-header name="X-Payload-SHA256" exists-action="delete" />
    <set-header name="X-RateLimit-Accounting" exists-action="delete" />
    <set-header name="X-RateLimit-Admission" exists-action="delete" />
    <set-header name="X-RateLimit-Estimated" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="x-api-key" exists-action="delete" />
    <set-header name="api-version" exists-action="delete" />
    <set-header name="OpenAI-Beta" exists-action="delete" />
    <set-header name="OpenAI-Organization" exists-action="delete" />
    <set-header name="OpenAI-Project" exists-action="delete" />
    <set-header name="anthropic-beta" exists-action="delete" />
    <set-header name="anthropic-organization" exists-action="delete" />
    <set-header name="anthropic-dangerous-direct-browser-access" exists-action="delete" />
    <set-header name="anthropic-version" exists-action="delete" />
    <choose>
      <when condition='@(${streaming_enabled} &amp;&amp; context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false))'>
        <set-backend-service base-url="${stream_url}" />
        <rewrite-uri template="/api/stream" copy-unmatched-params="false" />
        <set-query-parameter name="api-version" exists-action="delete" />
        <set-header name="X-MS-CLIENT-PRINCIPAL" exists-action="delete" />
        <set-header name="X-MS-CLIENT-PRINCIPAL-ID" exists-action="delete" />
        <set-header name="X-MS-CLIENT-PRINCIPAL-NAME" exists-action="delete" />
        <set-header name="X-MS-CLIENT-PRINCIPAL-IDP" exists-action="delete" />
        <set-header name="X-RateLimit-Reservation" exists-action="override"><value>@((string)context.Variables["reservation-id"])</value></set-header>
        <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
      </when>
      <otherwise>
        <choose>
          <when condition='@(!String.IsNullOrEmpty((string)context.Variables["api-protocol"]))'>
            <set-backend-service base-url='@((string)context.Variables["model-endpoint"])' />
            <rewrite-uri template='@((string)context.Variables["model-path"])' copy-unmatched-params="false" />
            <choose>
              <when condition='@(!String.IsNullOrEmpty((string)context.Variables["model-api-version"]))'>
                <set-query-parameter name="api-version" exists-action="override"><value>@((string)context.Variables["model-api-version"])</value></set-query-parameter>
              </when>
            </choose>
            <choose>
              <when condition='@(!String.IsNullOrEmpty((string)context.Variables["model-anthropic-version"]))'>
                <set-header name="anthropic-version" exists-action="override"><value>@((string)context.Variables["model-anthropic-version"])</value></set-header>
              </when>
            </choose>
            <authentication-managed-identity resource='@((string)context.Variables["model-audience"])' client-id="${gateway_client_id}" />
          </when>
          <otherwise>
            <set-backend-service base-url="${endpoint}" />
            <rewrite-uri template="${backend_path}" copy-unmatched-params="false" />
            ${version_policy}
            ${backend_query}
            ${provider_headers}
            <authentication-managed-identity resource="${ai_audience}" client-id="${gateway_client_id}" />
          </otherwise>
        </choose>
      </otherwise>
    </choose>
  </inbound>
  <backend><forward-request buffer-response="false" /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="X-RateLimit-Reservation" exists-action="override"><value>@((string)context.Variables["reservation-id"])</value></set-header>
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
    <choose>
      <when condition='@(context.Variables.GetValueOrDefault&lt;bool&gt;("streaming", false))'>
        <set-header name="X-RateLimit-Admission" exists-action="override"><value>conservative</value></set-header>
        <choose>
          <when condition="@(${streaming_enabled})">
            <set-header name="X-RateLimit-Accounting" exists-action="override"><value>provider-stream</value></set-header>
          </when>
        </choose>
      </when>
    </choose>
    <set-header name="RateLimit-Remaining" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["remaining"].ToString())</value></set-header>
    <set-header name="RateLimit-Reset" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["reset_at"].ToString())</value></set-header>
    ${settlement}
  </outbound>
  <on-error>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <trace source="rate-limiter" severity="error"><message>gateway_request_failed</message><metadata name="correlation_id" value="@(context.RequestId.ToString())" /><metadata name="error_reason" value="@(context.LastError.Reason)" /></trace>
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
  </on-error>
</policies>
