<policies>
  <inbound>
    <base />
    <include-fragment fragment-id="limiter-identity" />
    <set-variable name="service" value="${service}" />
    <set-variable name="api-protocol" value="${api_protocol}" />
    <set-variable name="model" value="${model}" />
    <set-variable name="price-version" value="${price_version}" />
    <set-variable name="streaming" value="@(false)" />
    <choose>
      <when condition='@(!context.Request.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json"))'>
        <return-response><set-status code="415" reason="JSON only" /></return-response>
      </when>
    </choose>
    <set-variable name="request-body" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
    <choose>
      <when condition='@(System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; ${max_body_bytes})'>
        <return-response><set-status code="413" reason="Bounded requests only" /></return-response>
      </when>
    </choose>
    <set-variable name="valid-json" value='@{
      try { JObject.Parse((string)context.Variables["request-body"]); return true; }
      catch { return false; }
    }' />
    <choose>
      <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("valid-json", false))'>
        <return-response><set-status code="400" reason="JSON object required" /></return-response>
      </when>
    </choose>
    ${admission}
    <choose>
      <when condition='@(!String.IsNullOrEmpty((string)context.Variables["api-protocol"]))'>
        <set-variable name="pinned-model-valid" value='@{
          var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
          return body["model"] == null || (body["model"].Type == JTokenType.String &amp;&amp; (string)body["model"] == (string)context.Variables["model"]);
        }' />
        <choose>
          <when condition='@(!context.Variables.GetValueOrDefault&lt;bool&gt;("pinned-model-valid", false))'>
            <return-response><set-status code="400" reason="Model must match the pinned deployment" /></return-response>
          </when>
        </choose>
        <set-body>@{
          var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
          body["model"] = (string)context.Variables["model"];
          return body.ToString();
        }</set-body>
      </when>
    </choose>
    ${llm_policy}
    <include-fragment fragment-id="limiter-reserve" />
    <set-backend-service base-url="${endpoint}" />
    <rewrite-uri template="${backend_path}" copy-unmatched-params="false" />
    ${version_policy}
    ${backend_query}
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="x-api-key" exists-action="delete" />
    <set-header name="api-version" exists-action="delete" />
    <set-header name="OpenAI-Beta" exists-action="delete" />
    <set-header name="OpenAI-Organization" exists-action="delete" />
    <set-header name="OpenAI-Project" exists-action="delete" />
    <set-header name="anthropic-beta" exists-action="delete" />
    <set-header name="anthropic-organization" exists-action="delete" />
    <set-header name="anthropic-dangerous-direct-browser-access" exists-action="delete" />
    ${provider_headers}
    <authentication-managed-identity resource="${ai_audience}" client-id="${gateway_client_id}" />
  </inbound>
  <backend><forward-request buffer-response="false" /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="X-RateLimit-Reservation" exists-action="override"><value>@((string)context.Variables["reservation-id"])</value></set-header>
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
    <set-header name="RateLimit-Remaining" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["remaining"].ToString())</value></set-header>
    <set-header name="RateLimit-Reset" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["reset_at"].ToString())</value></set-header>
    ${settlement}
  </outbound>
  <on-error>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <trace source="rate-limiter" severity="error"><message>gateway_request_failed</message><metadata name="correlation_id" value="@(context.RequestId.ToString())" /><metadata name="error_reason" value="@(context.LastError.Reason)" /></trace>
    <set-header name="X-RateLimit-Estimated" exists-action="override"><value>true</value></set-header>
  </on-error>
</policies>
