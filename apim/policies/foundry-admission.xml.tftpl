<!-- Chat contract: bounded inline text and client function tools, exactly one output-token cap,
     no stored history. Only what changes cost or the input bound is checked here; the provider
     still validates its own schema. The input bound is the request's UTF-8 size, which is an upper
     bound on tokens without a tokenizer, not a cost reservation. -->
<set-variable name="admission-error" value='@{
  try {
    var body = (JObject)context.Variables["request-json"];
    var fields = new [] {"model","messages","max_tokens","max_completion_tokens","n","stream","temperature","top_p","stop",
      "presence_penalty","frequency_penalty","seed","tools","tool_choice","parallel_tool_calls","reasoning_effort","store","stream_options"};
    foreach (var field in body.Properties()) {
      if (!fields.Contains(field.Name)) { return "unsupported chat field: " + field.Name; }
    }
    if ((body["max_tokens"] == null) == (body["max_completion_tokens"] == null)) { return "supply exactly one output-token cap"; }
    var max = body["max_tokens"] ?? body["max_completion_tokens"];
    if (max.Type != JTokenType.Integer || (long)max &lt; 1 || (long)max &gt; (int)context.Variables["model-max-output-tokens"]) { return "output-token cap exceeds the configured bound"; }
    if (body["n"] != null &amp;&amp; (body["n"].Type != JTokenType.Integer || (int)body["n"] != 1)) { return "n must be 1"; }
    if (body["stream"] != null &amp;&amp; body["stream"].Type != JTokenType.Boolean) { return "stream must be boolean"; }
    if ((bool?)body["store"] == true) { return "stored chat history is unsupported"; }
    var messages = body["messages"] as JArray;
    if (messages == null || messages.Count == 0 || messages.Count &gt; 128) { return "send 1-128 inline messages"; }
    foreach (var message in messages) {
      var content = message["content"];
      if (content == null || content.Type == JTokenType.Null || content.Type == JTokenType.String) { continue; }
      var blocks = content as JArray;
      if (blocks == null || blocks.Count == 0 || blocks.Count &gt; 128 ||
          blocks.Any(block =&gt; (string)block["type"] != "text" || block["text"] == null || block["text"].Type != JTokenType.String)) { return "media and opaque content are unsupported"; }
    }
    var tools = body["tools"] as JArray;
    if (body["tools"] != null &amp;&amp; (tools == null || tools.Count &gt; 128 || tools.Any(tool =&gt; (string)tool["type"] != "function"))) { return "only bounded client function tools are supported"; }
    if (System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["request-body"]) &gt; (int)context.Variables["model-max-input-tokens"]) { return "input exceeds the selected model bound"; }
    return "";
  } catch { return "malformed chat request fields"; }
}' />
<choose>
  <when condition='@(!String.IsNullOrEmpty((string)context.Variables["admission-error"]))'>
    <return-response><set-status code="400" reason="Unsupported request" /><set-body>@((string)context.Variables["admission-error"])</set-body></return-response>
  </when>
</choose>
