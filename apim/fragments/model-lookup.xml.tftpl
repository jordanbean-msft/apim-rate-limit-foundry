<fragment>
  <!-- Resolve protocol:alias against the deployment-time registry. Callers cannot
       select arbitrary destinations, audiences, prices or provider deployments.
       Terraform supplies each entry's backend_id, so the naming rule lives only there. -->
  <set-variable name="model" value='@{
    var requested = ((JObject)context.Variables["request-json"])["model"];
    if (requested == null) { return (string)context.Variables["legacy-default-alias"]; }
    return requested.Type == JTokenType.String ? (string)requested : "";
  }' />
  <set-variable name="model-entry" value='@{
    var registry = JObject.Parse("${model_registry}");
    var entry = registry[(string)context.Variables["api-protocol"] + ":" + (string)context.Variables["model"]] as JObject;
    return entry != null &amp;&amp; (string)entry["api_protocol"] == (string)context.Variables["api-protocol"] ? entry : new JObject();
  }' />
  <choose>
    <when condition='@(String.IsNullOrEmpty((string)context.Variables["model"]) || ((JObject)context.Variables["model-entry"]).Count == 0)'>
      <return-response><set-status code="400" reason="Unknown or incompatible model" /><set-body>{"error":"unknown_model"}</set-body></return-response>
    </when>
  </choose>
  <set-variable name="model-provider" value='@((string)((JObject)context.Variables["model-entry"])["model"])' />
  <set-variable name="model-backend-id" value='@((string)((JObject)context.Variables["model-entry"])["backend_id"])' />
  <!-- A registry entry marked pool is served by a native APIM backend pool. -->
  <set-variable name="model-pooled" value='@((bool?)((JObject)context.Variables["model-entry"])["pool"] == true)' />
  <set-variable name="model-path" value='@((string)((JObject)context.Variables["model-entry"])["path"])' />
  <set-variable name="model-audience" value='@((string)((JObject)context.Variables["model-entry"])["audience"])' />
  <set-variable name="model-api-version" value='@((string)((JObject)context.Variables["model-entry"])["api_version"])' />
  <set-variable name="model-max-input-tokens" value='@((int)((JObject)context.Variables["model-entry"])["max_input_tokens"])' />
  <set-variable name="model-max-output-tokens" value='@((int)((JObject)context.Variables["model-entry"])["max_output_tokens"])' />
</fragment>
