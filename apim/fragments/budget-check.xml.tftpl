<fragment>
  <send-request mode="new" response-variable-name="budget-response" timeout="${send_request_timeout}" ignore-error="true">
    <set-url>${function_url}/api/budgets/check</set-url>
    <set-method>POST</set-method>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="X-Correlation-ID" exists-action="override"><value>@((string)context.Variables["request-id"])</value></set-header>
    <set-body>@{
      return new JObject(
        new JProperty("request_id", (string)context.Variables["request-id"]),
        new JProperty("tenant_id", (string)context.Variables["tenant-id"]),
        new JProperty("principal_id", (string)context.Variables["principal-id"]),
        new JProperty("subscription_id", (string)context.Variables["subscription-id"]),
        new JProperty("model", (string)context.Variables["model"]),
        new JProperty("api_protocol", (string)context.Variables["api-protocol"]),
        new JProperty("streaming", (bool)context.Variables["streaming"])
      ).ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
    <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
  </send-request>
  <choose>
    <when condition='@(context.Variables.GetValueOrDefault&lt;IResponse&gt;("budget-response") == null)'>
      <return-response><set-status code="503" reason="Budget check unavailable" /><set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header></return-response>
    </when>
    <when condition='@(((IResponse)context.Variables["budget-response"]).StatusCode != 200)'>
      <return-response response-variable-name="budget-response"><set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header></return-response>
    </when>
  </choose>
  <set-variable name="decision" value='@(((IResponse)context.Variables["budget-response"]).Body.As&lt;string&gt;())' />
  <choose>
    <when condition='@((string)JObject.Parse((string)context.Variables["decision"])["request_id"] != (string)context.Variables["request-id"])'>
      <return-response><set-status code="503" reason="Invalid budget decision" /><set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header></return-response>
    </when>
    <when condition='@((bool?)JObject.Parse((string)context.Variables["decision"])["allowed"] != true)'>
      <return-response>
        <set-status code="429" reason="Monthly budget exhausted" />
        <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
        <set-header name="Retry-After" exists-action="override"><value>@(JObject.Parse((string)context.Variables["decision"])["retry_after"].ToString())</value></set-header>
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>@((string)context.Variables["decision"])</set-body>
      </return-response>
    </when>
  </choose>
</fragment>
