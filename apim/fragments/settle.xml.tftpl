<fragment>
  <send-request mode="new" response-variable-name="settlement-response" timeout="${send_request_timeout}" ignore-error="true">
    <set-url>${function_url}/api/decisions/settle</set-url>
    <set-method>POST</set-method>
    <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-body>@{
      var request = new JObject(
        new JProperty("reservation_id", (string)context.Variables["reservation-id"]),
        new JProperty("status", "actual"));
      if (context.Variables.ContainsKey("provider-usage")) {
        request["provider_usage"] = JObject.Parse((string)context.Variables["provider-usage"]);
      } else {
        request["usage"] = JObject.Parse((string)context.Variables["actual-usage"]);
      }
      return request.ToString();
    }</set-body>
    <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
  </send-request>
  <trace source="rate-limiter" severity="information">
    <message>limiter_settlement</message>
    <metadata name="correlation_id" value="@(context.RequestId.ToString())" />
    <metadata name="reservation_id" value='@((string)context.Variables["reservation-id"])' />
    <metadata name="function_status" value='@(context.Variables.ContainsKey("settlement-response") &amp;&amp; context.Variables["settlement-response"] != null ? ((IResponse)context.Variables["settlement-response"]).StatusCode.ToString() : "unavailable")' />
  </trace>
  <set-header name="X-RateLimit-Estimated" exists-action="override">
    <value>@{
      if (!context.Variables.ContainsKey("settlement-response") || context.Variables["settlement-response"] == null ||
          ((IResponse)context.Variables["settlement-response"]).StatusCode != 200) { return "true"; }
      var result = ((IResponse)context.Variables["settlement-response"]).Body.As&lt;JObject&gt;();
      var data = result["data"] as JObject;
      return data == null || (bool?)data["estimated"] != false ? "true" : "false";
    }</value>
  </set-header>
</fragment>
