<fragment>
  <send-request mode="new" response-variable-name="settlement-response" timeout="${send_request_timeout}" ignore-error="true">
    <set-url>${function_url}/api/decisions/settle</set-url>
    <set-method>POST</set-method>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-body>@{
      return new JObject(
        new JProperty("reservation_id", (string)context.Variables["reservation-id"]),
        new JProperty("usage", JObject.Parse((string)context.Variables["actual-usage"])),
        new JProperty("status", "actual")).ToString();
    }</set-body>
    <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
  </send-request>
  <set-header name="X-RateLimit-Estimated" exists-action="override">
    <value>@(!context.Variables.ContainsKey("settlement-response") || context.Variables["settlement-response"] == null || ((IResponse)context.Variables["settlement-response"]).StatusCode != 200 ? "true" : "false")</value>
  </set-header>
</fragment>
