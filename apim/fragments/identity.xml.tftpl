<fragment>
  <set-header name="X-Correlation-ID" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
  <choose>
    <when condition='@(context.Subscription == null || context.Product == null || String.IsNullOrEmpty(context.Request.Headers.GetValueOrDefault("Ocp-Apim-Subscription-Key", "")))'>
      <return-response><set-status code="401" reason="Product subscription key required" /></return-response>
    </when>
  </choose>
  <set-query-parameter name="subscription-key" exists-action="delete" />
  <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-scheme="Bearer" output-token-variable-name="validated-jwt">
    <openid-config url="${authority}/${tenant_id}/v2.0/.well-known/openid-configuration" />
    <audiences>${audiences}</audiences>
    <required-claims><claim name="tid" match="all"><value>${tenant_id}</value></claim></required-claims>
  </validate-jwt>
  <set-variable name="tenant-id" value='@(((Jwt)context.Variables["validated-jwt"]).Claims.GetValueOrDefault("tid", ""))' />
  <set-variable name="principal-id" value='@(((Jwt)context.Variables["validated-jwt"]).Claims.GetValueOrDefault("oid", ""))' />
  <set-variable name="subscription-id" value="@(context.Subscription.Id)" />
  <choose>
    <when condition='@(String.IsNullOrEmpty((string)context.Variables["principal-id"]) || String.IsNullOrEmpty(((Jwt)context.Variables["validated-jwt"]).Claims.GetValueOrDefault("scp", "")) || ((Jwt)context.Variables["validated-jwt"]).Claims.GetValueOrDefault("idtyp", "") == "app" || String.IsNullOrEmpty((string)context.Variables["tenant-id"]) || String.IsNullOrEmpty((string)context.Variables["subscription-id"]))'>
      <return-response><set-status code="401" reason="Delegated person identity required" /></return-response>
    </when>
  </choose>
  <set-variable name="caller-ref" value='@{
    var identity = (string)context.Variables["tenant-id"] + "\n" + (string)context.Variables["principal-id"];
    return BitConverter.ToString(System.Security.Cryptography.SHA256.Create().ComputeHash(System.Text.Encoding.UTF8.GetBytes(identity))).Replace("-", "").ToLowerInvariant();
  }' />
  <trace source="rate-limiter" severity="information">
    <message>gateway_caller</message>
    <metadata name="correlation_id" value="@(context.RequestId.ToString())" />
    <metadata name="caller_ref" value='@((string)context.Variables["caller-ref"])' />
    <metadata name="subscription_id" value='@((string)context.Variables["subscription-id"])' />
    <metadata name="product_id" value="@(context.Product.Id)" />
    <metadata name="api_id" value="@(context.Api.Id)" />
    <metadata name="operation_id" value="@(context.Operation.Id)" />
  </trace>
  <rate-limit-by-key calls="${burst_calls}" renewal-period="${burst_seconds}" counter-key='@((string)context.Variables["tenant-id"] + ":" + (string)context.Variables["subscription-id"])' />
  <set-variable name="request-id" value="@(context.RequestId.ToString())" />
</fragment>
