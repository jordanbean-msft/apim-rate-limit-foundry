<fragment>
  <send-request mode="new" response-variable-name="usage-response" timeout="${send_request_timeout}" ignore-error="true">
    <set-url>${function_url}/api/usage/record</set-url>
    <set-method>POST</set-method>
    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
    <set-header name="X-Correlation-ID" exists-action="override"><value>@((string)context.Variables["request-id"])</value></set-header>
    <set-body>@{
      JObject usage = null;
      try {
        var response = JObject.Parse((string)context.Variables["provider-body"]);
        usage = response["usage"] as JObject;
        if (usage != null &amp;&amp; System.Text.Encoding.UTF8.GetByteCount(usage.ToString(Newtonsoft.Json.Formatting.None)) &gt; 8192) { usage = null; }
      } catch { }
      var record = new JObject(
        new JProperty("request_id", (string)context.Variables["request-id"]),
        new JProperty("status", usage == null ? "usage_unknown" : "actual"));
      if (usage != null) { record["provider_usage"] = usage; }
      return record.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
    <authentication-managed-identity resource="${api_audience}" client-id="${gateway_client_id}" />
  </send-request>
  <choose>
    <when condition='@(context.Variables.GetValueOrDefault&lt;IResponse&gt;("usage-response") != null &amp;&amp; ((IResponse)context.Variables["usage-response"]).StatusCode == 200)'>
      <set-variable name="record-result" value='@(((IResponse)context.Variables["usage-response"]).Body.As&lt;string&gt;())' />
      <choose>
        <when condition='@((bool?)JObject.Parse((string)context.Variables["record-result"])["replayed"] == false)'>
          <set-variable name="usage-event" value='@(((JObject)JObject.Parse((string)context.Variables["record-result"])["event"]).ToString(Newtonsoft.Json.Formatting.None))' />
          <choose>
            <when condition='@(System.Text.Encoding.UTF8.GetByteCount((string)context.Variables["usage-event"]) &lt;= 16384)'>
              <log-to-eventhub logger-id="usage-events" partition-key='@{
                var item = JObject.Parse((string)context.Variables["usage-event"]);
                return (string)item["tenant_ref"] + ":" + (string)item["user_ref"];
              }'>@((string)context.Variables["usage-event"])</log-to-eventhub>
            </when>
            <otherwise>
              <trace source="usage-accounting" severity="error"><message>usage_event_publish_failed</message><metadata name="error_type" value="event_too_large" /></trace>
            </otherwise>
          </choose>
        </when>
      </choose>
    </when>
    <otherwise>
      <trace source="usage-accounting" severity="error"><message>usage_record_failed</message><metadata name="request_id" value='@((string)context.Variables["request-id"])' /></trace>
    </otherwise>
  </choose>
</fragment>
