// Admission cohort within the selected window. Settlements outside that window are not visible.
// Never sum policy debits: policies can overlap for the same reservation.
let Settlements = AppTraces
| where AppRoleName == "rate-limiter" and Message == "settlement_recorded"
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_max(TimeGenerated, *) by ReservationId
| project ReservationId, SettlementStatus = tostring(Properties.status),
    SettledCost = tolong(Properties.cost_micro_usd), Estimated = tobool(Properties.estimated),
    RefundedCost = tolong(Properties.refunded_cost_micro_usd);
AppTraces
| where AppRoleName == "rate-limiter" and Message == "rate_decision"
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_min(TimeGenerated, *) by ReservationId
| where tobool(Properties.allowed) == true
| extend ReservedCost = coalesce(tolong(Properties.reserved_cost_micro_usd), tolong(Properties.cost_micro_usd))
| join kind=leftouter Settlements on ReservationId
| extend Accounting = case(isempty(SettlementStatus), "Pending conservative reservation",
    Estimated == true, "Conservative settlement", "Actual settlement"),
    EffectiveCost = iff(isempty(SettlementStatus), ReservedCost, SettledCost)
| summarize Reservations = count(), KnownCostReservations = countif(isnotnull(EffectiveCost)),
    EffectiveUSD = sum(EffectiveCost) / 1000000.0,
    OriginalReservedUSD = sum(ReservedCost) / 1000000.0,
    RefundedUSD = sum(RefundedCost) / 1000000.0
    by Service = tostring(Properties.service), Protocol = tostring(Properties.api_protocol), Accounting
| order by Service asc, Protocol asc, Accounting asc
