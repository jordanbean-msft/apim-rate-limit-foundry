AppTraces
| where Message == "usage_recorded" and toint(Properties.event_version) == 2
| summarize arg_max(TimeGenerated, *) by EventId = tostring(Properties.event_id)
| summarize Requests = count(), ActualUSD = sumif(tolong(Properties.cost_micro_usd), tostring(Properties.status) == "actual") / 1000000.0,
    UnknownRequests = countif(tostring(Properties.status) == "usage_unknown")
    by SubscriptionId = tostring(Properties.subscription_id), Model = tostring(Properties.model),
    Protocol = tostring(Properties.api_protocol), Streaming = tobool(Properties.streaming)
| order by ActualUSD desc
