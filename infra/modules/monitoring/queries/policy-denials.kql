// Count binding policies, not all matched/blocked rules. Multiple binders can explain one denial.
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "reservation_policy_debit"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id),
    Policy = tostring(Properties.policy_id), Metric = tostring(Properties.metric)
| where isnotempty(ReservationId) and isnotempty(Policy)
| summarize arg_min(TimeGenerated, *) by ReservationId, Policy, Metric
| where tostring(Properties.policy_outcome) == "denied"
| summarize DeniedRequests = count() by Policy, Metric, SubscriptionId = tostring(Properties.subscription_id)
| top 15 by DeniedRequests desc
| render columnchart
