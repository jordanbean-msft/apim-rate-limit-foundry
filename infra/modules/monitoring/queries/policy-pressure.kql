// These are individual admission evaluations, not additive policy windows or billing totals.
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "reservation_policy_debit"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id), PolicyId = tostring(Properties.policy_id),
    Metric = tostring(Properties.metric)
| where isnotempty(ReservationId) and isnotempty(PolicyId)
| summarize arg_min(TimeGenerated, *) by ReservationId, PolicyId, Metric
| extend Demand = tolong(Properties.amount), Limit = tolong(Properties.limit),
    Remaining = tolong(Properties.remaining), Allowed = tobool(Properties.allowed)
| extend Outcome = coalesce(tostring(Properties.policy_outcome), iff(Allowed, "allowed", "legacy denied/blocked")),
    Applied = coalesce(tolong(Properties.applied_amount), iff(Allowed, Demand, tolong(0)))
| project TimeGenerated, SubscriptionId = tostring(Properties.subscription_id),
    Application = tostring(Properties.application_name), PolicyId, Metric,
    Service = tostring(Properties.service), Model = tostring(Properties.model),
    Protocol = tostring(Properties.api_protocol), Outcome, Demand, Applied, Remaining, Limit,
    DemandPctOfLimit = iff(Limit > 0, round(100.0 * Demand / Limit, 2), real(null)),
    RemainingPctOfLimit = iff(Limit > 0, round(100.0 * Remaining / Limit, 2), real(null)),
    ReservationId
| top 100 by TimeGenerated desc
