let BudgetHierarchy = AppTraces
| where Message == "budget_status"
| summarize arg_max(TimeGenerated, *) by BudgetId = tostring(Properties.budget_id)
| project BudgetId, Hierarchy = tostring(Properties.subject_type);
AppTraces
| where Message == "budget_decision" and tobool(Properties.allowed) == false
| extend RequestId = coalesce(tostring(Properties.request_id), tostring(Properties.correlation_id))
| where isnotempty(RequestId)
| summarize arg_max(TimeGenerated, *) by RequestId
| mv-expand BudgetId = extract_all(@"([A-Za-z0-9][A-Za-z0-9._-]*)", tostring(Properties.denied_budget_ids))
| extend BudgetId = tostring(BudgetId)
| join kind=leftouter BudgetHierarchy on BudgetId
| summarize DeniedRequests = count() by BudgetId, Hierarchy,
    Model = tostring(Properties.model), Reason = tostring(Properties.reason),
    UserRef = tostring(Properties.user_ref), Team = tostring(Properties.team_id),
    Department = tostring(Properties.department_id)
| order by DeniedRequests desc
