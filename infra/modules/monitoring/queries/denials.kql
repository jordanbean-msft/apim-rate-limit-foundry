// Keep historical denied_policy_ids as display text; older exporters used tuple-like strings.
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "rate_decision"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_min(TimeGenerated, *) by ReservationId
| where tobool(Properties.allowed) == false
| project TimeGenerated, ReservationId, CallerRef = tostring(Properties.caller_ref),
    SubscriptionId = tostring(Properties.subscription_id), Application = tostring(Properties.application_name),
    Streaming = tobool(Properties.streaming), Service = tostring(Properties.service),
    Protocol = tostring(Properties.api_protocol), Model = tostring(Properties.model),
    Reason = tostring(Properties.reason), DeniedPolicies = tostring(Properties.denied_policy_ids),
    Remaining = tolong(Properties.remaining), RetryAfterSeconds = tolong(Properties.retry_after),
    ResetAt = tostring(Properties.reset_at),
    RequestedConservativeUSD = todouble(Properties.reserved_cost_micro_usd) / 1000000.0
| top 100 by TimeGenerated desc
