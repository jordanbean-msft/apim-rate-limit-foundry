// Physical HTTP attempts. Percentiles summarize attempts, not reservation charges.
AppRequests
| where AppRoleName in ("rate-limiter", "rate-limiter-stream")
| where Name in ("POST /api/decisions/reserve", "POST /api/decisions/settle")
| summarize P50 = percentile(DurationMs, 50), P95 = percentile(DurationMs, 95)
    by TimeGenerated = bin(TimeGenerated, 1m), Name
| extend Percentiles = bag_pack("p50", P50, "p95", P95)
| mv-expand kind=array Percentiles
| extend Series = strcat(Name, " / ", tostring(Percentiles[0])),
    Milliseconds = todouble(Percentiles[1])
| project TimeGenerated, Milliseconds, Series
| order by TimeGenerated asc
| render timechart
