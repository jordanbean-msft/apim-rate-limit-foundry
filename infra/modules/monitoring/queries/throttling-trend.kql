// Budget denials only. Native/provider 429 attribution remains in the correlation detail tile.
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "rate_decision"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_min(TimeGenerated, *) by ReservationId
| where tobool(Properties.allowed) == false
| summarize DeniedRequests = count()
    by TimeGenerated = bin(TimeGenerated, 1m), Service = tostring(Properties.service)
| order by TimeGenerated asc
| render columnchart with (kind=stacked)
