// Resolve non-secret subscription IDs to application labels in the authorized portal.
let Settlements = AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "settlement_recorded"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_max(TimeGenerated, *) by ReservationId
| project ReservationId, SettledCost = tolong(Properties.cost_micro_usd),
    SettlementEstimated = tobool(Properties.estimated), CachedTokens = tolong(Properties.cached_input_tokens);
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "rate_decision"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_min(TimeGenerated, *) by ReservationId
| where isnotempty(tostring(Properties.caller_ref))
| extend Allowed = tobool(Properties.allowed),
    ReservedCost = coalesce(tolong(Properties.reserved_cost_micro_usd), tolong(Properties.cost_micro_usd))
| join kind=leftouter Settlements on ReservationId
| extend EffectiveCost = iff(Allowed, coalesce(SettledCost, ReservedCost), tolong(0))
| summarize AllowedRequests = countif(Allowed), DeniedRequests = countif(not(Allowed)),
    StreamingRequests = countif(tobool(Properties.streaming)),
    PendingReservations = countif(Allowed and isnull(SettledCost)),
    EstimatedSettlements = countif(SettlementEstimated == true),
    EffectiveUSD = sum(EffectiveCost) / 1000000.0,
    CachedInputTokens = sum(CachedTokens),
    DeniedPolicies = make_set_if(tostring(Properties.denied_policy_ids), not(Allowed), 64)
    by SubscriptionId = tostring(Properties.subscription_id),
    Application = tostring(Properties.application_name), CallerRef = tostring(Properties.caller_ref),
    Service = tostring(Properties.service), Model = tostring(Properties.model)
| order by DeniedRequests desc, EffectiveUSD desc
