// Actual LLM settlements only. Input categories are disjoint, not input total plus cache subsets.
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "settlement_recorded"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_max(TimeGenerated, *) by ReservationId
| where tostring(Properties.service) == "foundry" and tobool(Properties.estimated) == false
| extend Input = tolong(Properties.input_tokens), Output = tolong(Properties.output_tokens),
    Reads = tolong(Properties.cached_input_tokens),
    Writes5m = tolong(Properties.cache_write_input_tokens_5m),
    Writes1h = tolong(Properties.cache_write_input_tokens_1h)
| extend Categories = bag_pack(
    "Uncached input", max_of(0, Input - Reads - Writes5m - Writes1h),
    "Cache reads", Reads, "Cache writes 5m", Writes5m, "Cache writes 1h", Writes1h,
    "Output", Output)
| mv-expand kind=array Categories
| extend Series = tostring(Categories[0]), TokenCount = tolong(Categories[1])
| summarize Tokens = sum(TokenCount) by TimeGenerated = bin(TimeGenerated, 1m), Series
| order by TimeGenerated asc
| render columnchart with (kind=stacked)
