let Settlements = AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "settlement_recorded"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_max(TimeGenerated, *) by ReservationId
| project ReservationId, SettledCost = tolong(Properties.cost_micro_usd),
    SettlementStatus = tostring(Properties.status), Estimated = tobool(Properties.estimated),
    CachedInputTokens = tolong(Properties.cached_input_tokens);
let Pending = AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "stream_settlement_pending"
| extend ReservationId = tostring(Properties.reservation_id)
| summarize arg_max(TimeGenerated, *) by ReservationId
| project ReservationId, PendingReason = tostring(Properties.reason);
AppTraces
| where AppRoleName in ("rate-limiter", "rate-limiter-stream") and Message == "rate_decision"
| where isnotempty(tostring(Properties.subscription_id))
| extend ReservationId = tostring(Properties.reservation_id)
| where isnotempty(ReservationId)
| summarize arg_min(TimeGenerated, *) by ReservationId
| where tobool(Properties.allowed) and tobool(Properties.streaming)
| extend ReservedCost = coalesce(tolong(Properties.reserved_cost_micro_usd), tolong(Properties.cost_micro_usd))
| join kind=leftouter Settlements on ReservationId
| join kind=leftouter Pending on ReservationId
| extend EffectiveCost = coalesce(SettledCost, ReservedCost)
| project TimeGenerated, ReservationId, CallerRef = tostring(Properties.caller_ref),
    Model = tostring(Properties.model), Protocol = tostring(Properties.api_protocol),
    Accounting = case(isempty(SettlementStatus), "Pending conservative", Estimated == true, "Conservative settlement", "Actual"),
    PendingReason = iff(isempty(SettlementStatus), PendingReason, ""),
    ReservedUSD = ReservedCost / 1000000.0, EffectiveUSD = EffectiveCost / 1000000.0,
    RefundedUSD = max_of(0, ReservedCost - EffectiveCost) / 1000000.0, CachedInputTokens
| top 100 by TimeGenerated desc
