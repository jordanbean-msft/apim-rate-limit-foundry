{
  "streaming": {"enabled": true, "max_event_bytes": 65536, "timeout_seconds": 180},
  "azure": {
    "subscription_id": "${AZURE_SUBSCRIPTION_ID}",
    "tenant_id": "${AZURE_TENANT_ID}",
    "location": "${AZURE_LOCATION}",
    "environment_name": "${AZURE_ENV_NAME}",
    "resource_group_name": "${AZURE_RESOURCE_GROUP}",
    "principal_id": "${AZURE_PRINCIPAL_ID}"
  },
  "azure_cloud": "${AZURE_CLOUD}",
  "naming": {"project_name": "ailimit"},
  "public_network_access_enabled": "${PUBLIC_NETWORK_ACCESS_ENABLED}",
  "network": {
    "private_endpoint_subnet_id": "${PRIVATE_ENDPOINT_SUBNET_ID}",
    "functions_subnet_id": "${FUNCTIONS_SUBNET_ID}",
    "web_subnet_id": "${WEB_SUBNET_ID}",
    "apim_subnet_id": "${APIM_SUBNET_ID}"
  },
  "monitoring": {"sku": "PerGB2018", "retention_in_days": 30},
  "event_hubs": {
    "sku": "Standard",
    "capacity": "${EVENT_HUB_CAPACITY}",
    "partition_count": "${EVENT_HUB_PARTITIONS}",
    "message_retention": "${EVENT_HUB_RETENTION_DAYS}",
    "minimum_tls_version": "1.2",
    "propagation_wait_duration": "60s"
  },
  "hosting": {
    "functions_sku": "P1v2",
    "web_sku": "P1v2",
    "python_version": "3.12",
    "node_version": "24-lts",
    "function_always_on": false,
    "web_always_on": false,
    "stream_always_on": true,
    "function_workers": 1,
    "web_workers": 1,
    "minimum_tls_version": "1.2",
    "cors_origins": [],
    "allowed_client_applications": ["04b07795-8ddb-461a-bbee-02f9e1bf7b46"],
    "telemetry_sampling_ratio": 1,
    "log_retention_days": 7,
    "log_disk_quota_mb": 100,
    "max_input_tokens": "${MAX_INPUT_TOKENS}"
  },
  "storage": {
    "account_tier": "Standard",
    "account_replication_type": "ZRS",
    "table_name": "RateLimiter"
  },
  "redis": {
    "managed_sku": "Balanced_B1",
    "high_availability": true,
    "government_capacity": 1,
    "inspection_enabled": "${REDIS_INSPECTION_ENABLED}",
    "minimum_tls_version": "1.2",
    "token_scope": "${REDIS_TOKEN_SCOPE}"
  },
  "identity": {
    "admin_object_ids": [],
    "reader_object_ids": [],
    "propagation_wait_duration": "60s"
  },
  "gateway": {
    "sku_name": "Developer_1",
    "publisher_name": "${APIM_PUBLISHER_NAME}",
    "publisher_email": "${APIM_PUBLISHER_EMAIL}",
    "client_audiences": ["${GATEWAY_CLIENT_AUDIENCE}"],
    "burst_calls": 60,
    "burst_seconds": 60,
    "max_body_bytes": 1048576,
    "max_output_tokens": 4096,
    "send_request_timeout": 10,
    "enable_optional_llm_policy": false,
    "llm_policy_verified": false,
    "llm_tokens_per_minute": 100000,
    "diagnostic_sampling_percentage": 100,
    "openai_byte_tokenizer_verified": "${OPENAI_BYTE_TOKENIZER_VERIFIED}"
  },
  "ai": {
    "foundry": {
      "enabled": "${ENABLE_FOUNDRY}",
      "create": "${CREATE_FOUNDRY}",
      "resource_id": "${FOUNDRY_RESOURCE_ID}",
      "endpoint": "${FOUNDRY_ENDPOINT}",
      "audience": "${FOUNDRY_TOKEN_AUDIENCE}",
      "sku_name": "S0",
      "location": "${FOUNDRY_LOCATION}",
      "deployment_name": "${FOUNDRY_DEPLOYMENT_NAME}",
      "model_name": "${FOUNDRY_MODEL_NAME}",
      "model_version": "${FOUNDRY_MODEL_VERSION}",
      "deployment_sku": "${FOUNDRY_DEPLOYMENT_SKU}",
      "deployment_capacity": "${FOUNDRY_DEPLOYMENT_CAPACITY}",
      "api_version": "${FOUNDRY_API_VERSION}",
      "price_version": "${FOUNDRY_PRICE_VERSION}"
    }
  },
  "llm_protocols": {
    "responses": {
      "enabled": "${ENABLE_RESPONSES}",
      "capability_verified": "${RESPONSES_CAPABILITY_VERIFIED}",
      "government_verified": "${RESPONSES_GOVERNMENT_VERIFIED}",
      "byte_tokenizer_verified": "${RESPONSES_BYTE_TOKENIZER_VERIFIED}",
      "private_endpoint_verified": "${RESPONSES_PRIVATE_ENDPOINT_VERIFIED}",
      "resource_id": "${RESPONSES_RESOURCE_ID}",
      "endpoint": "${RESPONSES_ENDPOINT}",
      "audience": "${RESPONSES_TOKEN_AUDIENCE}",
      "location": "${RESPONSES_LOCATION}",
      "deployment_name": "${RESPONSES_DEPLOYMENT_NAME}",
      "price_version": "${RESPONSES_PRICE_VERSION}",
      "role_definition_name": "${RESPONSES_ROLE_NAME}",
      "api_version": "${RESPONSES_API_VERSION}"
    }
  },
  "llm_models": ${LLM_MODELS},
  "managed_models": ${MANAGED_MODELS},
  "applications": ${APPLICATION_SUBSCRIPTIONS_CONFIG},
  "portal_key_vault": {
    "sku_name": "standard",
    "soft_delete_retention_days": 90,
    "purge_protection_enabled": true,
    "propagation_wait_duration": "60s"
  },
  "tags": {"SecurityControl": "Ignore"}
}
