{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sync-venv",
      "type": "process",
      "command": "uv",
      "args": ["sync", "--extra", "dev"],
      "problemMatcher": []
    },
    {
      "label": "web:runtime-check",
      "type": "process",
      "command": "node",
      "args": ["-e", "if (Number(process.versions.node.split('.')[0]) !== 24) { console.error('Node 24 LTS is required.'); process.exit(1); }"],
      "problemMatcher": []
    },
    {
      "label": "web:install",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "web", "ci"],
      "dependsOn": "web:runtime-check",
      "problemMatcher": []
    },
    {
      "label": "setup",
      "dependsOn": ["sync-venv", "web:install"],
      "problemMatcher": []
    },
    {
      "label": "build",
      "dependsOn": ["package-python", "package-stream", "web:build"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "package-python",
      "type": "process",
      "command": "uv",
      "args": ["build"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "package-stream",
      "type": "process",
      "command": "${workspaceFolder}/infra/scripts/package-stream.sh",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "run-stream",
      "type": "process",
      "command": "uv",
      "args": ["run", "--project", "${workspaceFolder}", "func", "start", "--port", "7072"],
      "options": {
        "cwd": "${workspaceFolder}/stream",
        "env": {"PYTHON_ENABLE_INIT_INDEXING": "1"}
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {"regexp": "^$"},
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Job host started|Functions:)"
        }
      }
    },
    {
      "label": "run-api",
      "type": "process",
      "command": "uv",
      "args": ["run", "apim-rate-limit-foundry"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {"regexp": "^$"},
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on"
        }
      }
    },
    {
      "label": "run-functions",
      "type": "process",
      "command": "uv",
      "args": ["run", "func", "start"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {"regexp": "^$"},
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Job host started|Functions:)"
        }
      }
    },
    {
      "label": "web:dev",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "web", "run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {"regexp": "^$"},
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "test",
      "type": "process",
      "command": "uv",
      "args": ["run", "pytest"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "test-strict",
      "type": "process",
      "command": "uv",
      "args": ["run", "pytest", "-W", "error"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "coverage",
      "type": "process",
      "command": "uv",
      "args": ["run", "pytest", "--cov", "--cov-report=xml", "--cov-report=term-missing"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "process",
      "command": "uv",
      "args": ["run", "ruff", "check", "."],
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "process",
      "command": "uv",
      "args": ["run", "ruff", "format", "."],
      "problemMatcher": []
    },
    {
      "label": "type-check",
      "type": "process",
      "command": "uv",
      "args": ["run", "mypy", "src/"],
      "problemMatcher": []
    },
    {
      "label": "seed:preview",
      "type": "process",
      "command": "uv",
      "args": ["run", "python", "scripts/seed.py"],
      "problemMatcher": []
    },
    {
      "label": "archive:legacy",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "python", "scripts/archive_legacy_config.py",
        "--input", "${input:legacyExport}", "--output", "${input:legacyArchive}"
      ],
      "problemMatcher": []
    },
    {
      "label": "format:check",
      "type": "process",
      "command": "uv",
      "args": ["run", "ruff", "format", "--check", "."],
      "problemMatcher": []
    },
    {
      "label": "web:build",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "web", "run", "build"],
      "dependsOn": "web:runtime-check",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "web:test",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "web", "run", "test", "--", "--run"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "web:lint",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "web", "run", "lint"],
      "problemMatcher": []
    },
    {
      "label": "web:type-check",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "web", "run", "typecheck"],
      "problemMatcher": []
    },
    {
      "label": "infra:init",
      "type": "process",
      "command": "terraform",
      "args": ["-chdir=infra", "init", "-backend=false"],
      "problemMatcher": []
    },
    {
      "label": "infra:fmt",
      "type": "process",
      "command": "terraform",
      "args": ["-chdir=infra", "fmt", "-check", "-recursive"],
      "problemMatcher": []
    },
    {
      "label": "infra:test",
      "type": "process",
      "command": "terraform",
      "args": ["-chdir=infra", "test"],
      "dependsOn": "infra:init",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "gateway:test",
      "type": "process",
      "command": "uv",
      "args": ["run", "python", "-W", "error", "-m", "unittest", "discover", "-s", "apim/tests", "-v"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "infra:validate",
      "type": "process",
      "command": "terraform",
      "args": ["-chdir=infra", "validate"],
      "dependsOn": "infra:init",
      "problemMatcher": []
    },
    {
      "label": "validate",
      "dependsOn": [
        "lint", "format:check", "type-check", "test-strict", "web:lint", "web:type-check",
        "web:test", "web:build", "infra:fmt", "infra:validate", "infra:test", "gateway:test"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id": "legacyExport", "type": "promptString", "description": "Path to exported legacy JSON"},
    {"id": "legacyArchive", "type": "promptString", "description": "New archive path (must not exist)"}
  ]
}
